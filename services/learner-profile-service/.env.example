# MathQuest Learner Profile Service — environment template (placeholders only).
# The service loads the repository ROOT .env file; copy the variables you need there.
# Never commit real credentials. Obtain the MongoDB URI from the project database owner.

# MongoDB (required). There is no built-in fallback: if unset, the service starts
# but refuses to connect and /api/health/database reports the database as unavailable.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?appName=<app-name>
MONGODB_DB_NAME=mathquest_db

# HTTP port (optional, default 5001)
LEARNER_PROFILE_PORT=5001

# Comma-separated browser origins allowed to send session cookies (optional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Session cookie issued by the auth service (optional, default mathquest_session)
AUTH_COOKIE_NAME=mathquest_session

# Tests only: local throwaway MongoDB for database-backed tests (see tests/conftest.py).
# Must be a plain mongodb:// localhost URI; tests always use the 'mathquest_test' database.
# MATHQUEST_TEST_MONGODB_URI=mongodb://127.0.0.1:27017
